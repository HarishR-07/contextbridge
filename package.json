{
  "name": "contextbridge",
  "version": "0.1.0",
  "description": "Stop losing context in long AI chats. Create editable, evidence-linked project snapshots and portable handoffs for Claude Code, Cursor, and more. Self-hosted with your own API key.",
  "keywords": [
    "ai-context-management",
    "context-loss",
    "long-context",
    "conversation-handoff",
    "ai-handoff",
    "project-memory",
    "chatgpt",
    "claude",
    "gemini",
    "cursor",
    "context-engineering",
    "self-hosted",
    "bring-your-own-key"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.test.ts && tsx tests/security.test.ts"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.1",
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
