# Optional gate for a private hosted deployment. Use a random value of 20+ chars in production.
ACCESS_CODE=
# Optional: receives only {result, at} when a user answers the feedback question (e.g. a Zapier/Make/Slack webhook).
FEEDBACK_WEBHOOK_URL=

# Security
# Production requires ACCESS_CODE unless this is an intentionally public BYOK deployment.
# Public deployments should also have an external shared rate limiter.
ALLOW_PUBLIC=
# Requests per minute per IP (default 20)
RATE_LIMIT_PER_MIN=
# Optional user accounts and private cloud project saves (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
